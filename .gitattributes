# Normalize line endings: store LF in the repo, check out LF everywhere
* text=auto eol=lf

# Store LF in the repo; check out with each OS's native line endings
* text=auto

# Binary files: never touch
*.png binary
*.jpg binary
*.pdf binary
*.mp4 binary

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf